import { WeeklyTherapeuticPlan } from '../types';
import { DEFAULT_STANDARDS, CLINICAL_PROTOCOLS } from '../constants';

function parsePlanPayload(serializedPlan: string): WeeklyTherapeuticPlan {
  try {
    return JSON.parse(serializedPlan) as WeeklyTherapeuticPlan;
  } catch {
    throw new Error('invalid JSON in generated plan payload');
  }
}

export async function transformMenu(
  originalMenu: string,
  diagnosis: string,
  patientDetails?: string
): Promise<WeeklyTherapeuticPlan> {
  const parsed = parsePlanPayload(originalMenu);
  const rationale =
    CLINICAL_PROTOCOLS[diagnosis] || parsed.rationale || 'Standard clinical nutritional therapy protocol.';

  return {
    ...parsed,
    standards: parsed.standards || DEFAULT_STANDARDS,
    rationale,
    clinicalAlignmentScore: parsed.clinicalAlignmentScore ?? 0.93,
    preparedBy: parsed.preparedBy || 'Local Clinical Synthesizer',
    updatedDate: new Date().toISOString().slice(0, 10),
    engineMode: parsed.engineMode || 'OFFLINE_INTERNAL_API',
    notes: [
      ...(parsed.notes || []),
      patientDetails ? `Clinical narrative retained locally: ${patientDetails}` : 'No additional patient narrative provided',
      'Deterministic local synthesis path enforced; no external API used',
    ],
  };
}

export async function chatWithDietitian(message: string): Promise<string> {
  const m = message.toLowerCase();
  if (m.includes('sglt2')) {
    return 'Local diabetes safety rule: avoid ketogenic patterns with SGLT2 inhibitors and prompt ketone monitoring during fasting or peri-operative periods.';
  }
  if (m.includes('fiber') || m.includes('fibre')) {
    return 'Local diabetes MNT rule: target at least 14 g fiber per 1000 kcal and prefer minimally processed high-fiber carbohydrates.';
  }
  if (m.includes('renal')) {
    return 'Local renal rule: stable CKD G3-G5 protein default is about 0.8 g/kg, while higher nutritional risk requires clinician-reviewed escalation.';
  }
  if (m.includes('alcohol')) {
    return 'Local alcohol rule: prompt delayed hypoglycemia checks when alcohol is logged with insulin or insulin secretagogues.';
  }
  return 'Local clinical assistant: ask about diabetes safety rules, fasting risk, fibre density, renal thresholds, or activity restrictions.';
}
