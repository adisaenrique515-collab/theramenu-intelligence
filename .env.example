# ── Copy this file to .env.local and fill in real values ─────────────────────
# .env.local is gitignored and never committed.

# ── Execution mode ────────────────────────────────────────────────────────────
# Set to "true" to run fully offline (no Claude AI, no live USDA calls).
# Any other value (or omit) to use live APIs when keys are present.
VITE_USE_MOCK_DATA=false

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Required for the AI-refinement and ChatBot features.
# Server-side only — never exposed in the browser bundle.
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── USDA FoodData Central API ─────────────────────────────────────────────────
# Required for live nutrient enrichment (Stage 3 of plan generation).
# Server-side only — never exposed in the browser bundle.
# Register for a free key: https://fdc.nal.usda.gov/api-guide.html
VITE_USDA_FDC_API_KEY=your_usda_fdc_api_key_here
